# Supabase Edge Functions — local secrets (copy to .env; never commit .env)
# Loaded automatically on `supabase start` and `supabase functions serve`.
# See docs/API_KEYS_AND_ENV.md. Push to cloud: `npx supabase secrets set --env-file .env`
#
# IMPORTANT: Put real keys only in supabase/functions/.env (git-ignored), NOT in this file.

# LLM providers (ai-gateway) — set at least one for plan/concierge/event_suggest
GEMINI_API_KEY=
# Optional free-tier/test Gemini key. When set it is tried FIRST by ai-gateway and
# weekly-spark-cron; GEMINI_API_KEY becomes the automatic fallback (rate limits/quota).
GEMINI_API_KEY_TEST=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional Anthropic model overrides (Premium routing — see docs/API_KEYS_AND_ENV.md):
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_LITE=claude-3-5-haiku-20241022
# ANTHROPIC_MODEL_PLAN=claude-sonnet-4-20250514

# Rate limiting + AI response cache (ai-gateway; recommended for production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Production CORS (ai-gateway, delete-account) — comma-separated origins; unset = localhost dev defaults
# CORS_ALLOWED_ORIGINS=https://orjccytcmklzcfjgqwwj.supabase.co

# Push (notify-fanout, pending-plan-confirm, expo-push-notify) — Expo account access token
# EXPO_ACCESS_TOKEN=

# notify-fanout / report-notify webhook auth — must match private.webhook_config.secret in the DB
# WEBHOOK_SECRET=

# report-notify — DSA moderation inbox. Two independent, optional delivery channels;
# when neither is set, reports still land in user_reports / message_reports and the
# function logs only.
#
# 1) SMTP email (primary — customer-care@mywinkly.de mailbox at united-domains):
# SMTP_HOST=smtps.udag.de
# SMTP_PORT=587
# SMTP_TLS=false
# SMTP_USER=customer-care@mywinkly.de
# SMTP_PASS=
# REPORT_EMAIL_TO=customer-care@mywinkly.de
# REPORT_EMAIL_FROM=customer-care@mywinkly.de
#
# 2) Incoming webhook (Slack/Discord/relay) — can run alongside or instead of email:
# REPORT_WEBHOOK_URL=
# REPORT_WEBHOOK_FORMAT=slack

# auth-redirect CSRF signing (min 16 chars; required for prod HTTPS redirect)
# AUTH_REDIRECT_STATE_SECRET=

# External events (get-nearby-external-events) — Ticketmaster is the primary provider (free Discovery API
# key at https://developer.ticketmaster.com). Meetup/Eventbrite are optional and only run if their key is set.
# TICKETMASTER_API_KEY=
# MEETUP_API_KEY=
# EVENTBRITE_PRIVATE_TOKEN=

# Google Places grounding (ai-gateway, weather-pivot-cron, weekly-spark-cron).
# REQUIRED for Weekly Spark: weekly-spark-cron FAILS CLOSED without it (produces no Spark rather
# than emitting model-from-memory venues). Optional elsewhere (ai-gateway degrades to world knowledge).
# Same key used by Places grounding + the shared verified_places cache (resolveVerifiedPlace).
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Scheduled crons (weather-pivot-cron, weekly-spark-cron, calendar-sync-sweep) — shared
# secret, must match private.webhook_config.cron_secret in the DB (see the cron schedule
# migrations, including 20260802120000_calendar_sync_sweep_cron_schedule.sql).
# CRON_SECRET=

# Cloud calendar sync (calendar-oauth-start/callback/disconnect, calendar-freebusy,
# calendar-sync-confirmed-event, calendar-sync-sweep) — see docs/SUPABASE_CALENDAR_MAPS_INTEGRATION.md.
# Google: Cloud Console project with Calendar API enabled + a Web application OAuth client.
#   Authorized redirect URI: https://<project-ref>.supabase.co/functions/v1/calendar-oauth-callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Microsoft: Entra ID app registration, Graph delegated permission Calendars.ReadWrite +
# offline_access, "Accounts in any organizational directory and personal Microsoft accounts",
# same redirect URI pattern as Google above.
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# Signs the OAuth connect-flow CSRF state (min 16 chars) — independent of AUTH_REDIRECT_STATE_SECRET.
# CALENDAR_OAUTH_STATE_SECRET=
# 32-byte base64url key that encrypts OAuth tokens at rest in calendar_connections.token_encrypted.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CALENDAR_TOKEN_ENCRYPTION_KEY=
# Only during a key rotation: the PREVIOUS key, so blobs written with it still decrypt.
# Set it, deploy, let the sweep re-encrypt, then remove it. See _shared/calendarTokenCrypto.ts.
# CALENDAR_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Weekly Spark (weekly-spark-cron) — sponsorship rails are OFF at launch (organic-only).
# SPARK_SPONSORED_ENABLED=false
# SPARK_MAX_USERS=150

# ── AI cost controls (ai-gateway) ──────────────────────────────────────────────
# Added by the August 2026 audit. See docs/AI_COST_CONTROLS.md.

# Rate limiting now fails CLOSED: if Upstash is unreachable or unconfigured the
# gateway refuses AI tasks rather than serving them unlimited. Set this to true
# ONLY in local dev, where there is no Upstash instance. Never in production.
# AI_RATELIMIT_OPTIONAL=false

# Per-user daily spend ceiling, in micro-euros (1 EUR = 1_000_000). 0 disables.
# The per-minute burst limits do nothing about steady all-day usage, which is
# the shape an unexpected provider bill actually takes.
# Suggested starting point once you have a week of beta data: 50000 (EUR 0.05).
# AI_DAILY_USER_COST_MICROS=0

# Global spend ceiling for the current UTC month, in micro-euros. 0 disables.
# This is the backstop that does not depend on anyone watching a dashboard.
# AI_MONTHLY_GLOBAL_COST_MICROS=0

# Override the model price table without a deploy. USD per 1M tokens.
# AI_PRICE_TABLE_JSON={"gemini-3.5-flash":{"in":0.30,"out":2.50}}
# AI_USD_PER_EUR=1.08
